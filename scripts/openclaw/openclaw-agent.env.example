# Knowhere OpenClaw cron runtime configuration

# Local repository path on the host running OpenClaw.
KNOWHERE_REPO_ROOT=/opt/work/knowhere

# OpenClaw workspace and memory locations.
OPENCLAW_WORKSPACE=/opt/openclaw/workspace-pipnn
OPENCLAW_MEMORY_DIR=/opt/openclaw/workspace-pipnn/memory

# Branch used by the agent.
TARGET_BRANCH=feat/pipnn-diskann

# Optional custom task queue template.
# TASK_QUEUE_TEMPLATE=/opt/work/knowhere/docs/openclaw/TASK_QUEUE.md

# Optional log/lock overrides.
# OPENCLAW_LOG_DIR=/opt/openclaw/workspace-pipnn/logs
# CRON_LOCK_FILE=/tmp/knowhere-pipnn-openclaw.lock

# Command used by run-pipnn-cron.sh to trigger OpenClaw.
# Keep this as a single shell command line.
OPENCLAW_RUN_CMD="openclaw run --workspace ${OPENCLAW_WORKSPACE} --prompt-file ${KNOWHERE_REPO_ROOT}/docs/openclaw/pipnn-agent-prompt.md --timeout 20m"

# Remote build config path used by scripts/remote/*.sh
KNOWHERE_REMOTE_ENV=${HOME}/.config/knowhere-x86-remote/remote.env

# If remote host must be reached through socks5, configure ~/.ssh/config
# alias (for example knowhere-x86-hk-proxy) and set REMOTE_HOST to that alias
# in ${KNOWHERE_REMOTE_ENV}.
